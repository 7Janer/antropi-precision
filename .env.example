# Keep the Gemini key server-side. Never prefix it with NEXT_PUBLIC_.
GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.8-flash

# Leave blank to use the Site's built-in API route. For the Docker microservices,
# use http://localhost:8080 during local development.
NEXT_PUBLIC_API_BASE_URL=

# Set this to your final Vercel URL after the first deployment.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
